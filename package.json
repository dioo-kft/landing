{
  "name": "dioo-landing-page",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "deploy": "push-dir --dir=dist --branch=gh-pages --cleanup",
    "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt",
    "build": "cross-env NODE_ENV=production NODE_OPTIONS=--openssl-legacy-provider nuxt build",
    "start": "cross-env NODE_ENV=production nuxt start -p 3000 -H 0.0.0.0",
    "generate": "cross-env NODE_OPTIONS=--openssl-legacy-provider nuxt generate"
  },
  "dependencies": {
    "bootstrap": "^4.6.1",
    "bootstrap-vue": "^2.21.2",
    "core-js": "^3.19.3",
    "nuxt": "^2.15.8",
    "nuxt-cookie-control": "^1.9.91",
    "vanilla-cookieconsent": "^2.8.0",
    "vue": "^2.6.14",
    "vue-server-renderer": "^2.6.14",
    "vue-template-compiler": "^2.6.14",
    "webpack": "^4.46.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "push-dir": "^0.4.1"
  }
}
